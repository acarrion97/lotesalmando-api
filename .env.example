# ── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
# Orígenes permitidos (coma separada). En desarrollo: http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173
# URL pública base del API (sin barra final). Alimenta el "server" por defecto
# de la documentación Swagger. En producción (Render):
#   https://lotes-al-mando-api.onrender.com
# En desarrollo apunta al puerto local:
#   http://localhost:3100
API_URL=https://lotes-al-mando-api.onrender.com

# ── Supabase (PostgreSQL) ───────────────────────────────────────────────────
# URL del proyecto y clave de SERVICE ROLE (solo backend: nunca al navegador).
# Se apunta al MISMO esquema que usa el frontend de lotesalmando.com.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
